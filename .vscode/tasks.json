{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Get Survey Data",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Get-SurveyData.ps1",
                "-Server",
                "${input:server}",
                "-Survey",
                "${input:survey}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "server",
            "type": "pickString",
            "description": "Select server",
            "options": [
                "prod.yourserver.com",
                "staging.yourserver.com",
                "dev.yourserver.com"
            ],
            "default": "prod.yourserver.com"
        },
        {
            "id": "survey",
            "type": "promptString",
            "description": "Enter Survey ID (number)",
            "default": "12345"
        }
    ]
}
